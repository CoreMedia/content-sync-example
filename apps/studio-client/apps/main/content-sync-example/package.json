{
  "name": "@coremedia-blueprint/studio-client.main.studio-client.labs-beta-ingest-client",
  "author": "Blueprint",
  "version": "1.0.0-SNAPSHOT",
  "private": true,
  "dependencies": {
    "@coremedia/studio-client.cap-base-models": "catalog:",
    "@coremedia/studio-client.cap-rest-client": "catalog:",
    "@coremedia/studio-client.client-core": "catalog:",
    "@coremedia/studio-client.client-core-impl": "catalog:",
    "@coremedia/studio-client.app-context-models": "catalog:",
    "@coremedia/studio-client.core-icons": "catalog:",
    "@coremedia/studio-client.ext.studio-theme": "catalog:",
    "@coremedia/studio-client.ext.ui-components": "catalog:",
    "@coremedia/studio-client.main.bpbase-studio-components": "catalog:",
    "@coremedia/studio-client.main.editor-components": "catalog:",
    "@jangaroo/ext-ts": "catalog:",
    "@jangaroo/runtime": "catalog:"
  },
  "devDependencies": {
    "@jangaroo/build": "catalog:",
    "@jangaroo/core": "catalog:",
    "@jangaroo/joounit": "catalog:",
    "eslint": "catalog:",
    "rimraf": "catalog:"
  },
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./build",
    "build": "jangaroo build",
    "watch": "jangaroo watch",
    "publish": "jangaroo publish",
    "lint": "eslint \"src/**/*.ts\""
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "coremedia": {
    "projectExtensionFor": "studio-client.main"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false,
    "exports": {
      "./*": {
        "types": "./src/*.d.ts",
        "default": "./src/*.js"
      }
    }
  }
}
